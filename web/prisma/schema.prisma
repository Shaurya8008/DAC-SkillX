// SkillX data model.
//
// Runs on PostgreSQL (Supabase). `skills`/`requiredSkills`/`embedding` are
// kept as JSON strings rather than native TEXT[]/vector(1536) columns for
// now — see PRD sec. 6 for the target pgvector shape; adopting it is a
// later optimization (HNSW similarity search at scale), not required to
// run or deploy the app, since cosine similarity is computed in application
// code today.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Profile {
  id           String   @id @default(uuid())
  authUserId   String   @unique
  fullName     String
  email        String   @unique
  passwordHash String? // null for accounts created via Google sign-in
  role         String   @default("student") // student | admin
  githubHandle String?
  erp          String?
  batch        String?
  bio          String?
  skills       String   @default("[]") // JSON string[]; Postgres target: TEXT[]
  embedding    String? // JSON number[1536]; Postgres target: vector(1536)

  // FR-04 GitHub Repo Vetting + FR-05 Adaptive Diagnostic Engine
  verifiedSkills String  @default("[]") // JSON string[] — skills backed by repo evidence or a passed quiz
  repoStack      String? // JSON string[] — primary language stack from the last analyzed repo
  repoComplexity Float? // 0-10 complexity score from the last analyzed repo

  // Forgot-password: a single active reset token at a time is enough at
  // pilot scale. Stores a SHA-256 hash of the token, never the raw value.
  resetTokenHash      String?   @unique
  resetTokenExpiresAt DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  opportunitiesCreated Opportunity[]
  matches              Match[]
}

model Opportunity {
  id              String   @id @default(uuid())
  title           String
  description     String
  opportunityType String // hackathon | research | campus_role | project
  requiredSkills  String   @default("[]") // JSON string[]; Postgres target: TEXT[]
  embedding       String? // JSON number[1536]; Postgres target: vector(1536)
  createdById     String
  createdBy       Profile  @relation(fields: [createdById], references: [id], onDelete: Cascade)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  matches Match[]
}

model Match {
  id             String      @id @default(uuid())
  studentId      String
  student        Profile     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  opportunityId  String
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  hardSkillScore Float
  semanticScore  Float
  finalScore     Float
  status         String      @default("suggested") // suggested | applied | accepted | declined
  createdAt      DateTime    @default(now())

  @@unique([studentId, opportunityId])
}
